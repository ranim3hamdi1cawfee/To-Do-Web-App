<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login | TaskFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body class="login-page">
    <div class="container-box">
        <h1 class="title">Login</h1>

        {% if error %}
            <div class="alert alert-danger" id="error-box" style="display:flex; justify-content:space-between; align-items:center;">
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                <span onclick="document.getElementById('error-box').style.display='none'" style="cursor:pointer; font-size:18px;">&times;</span>
            </div>
        {% endif %}

        <form method="post">
            <div class="input-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}"
                       placeholder="Enter username" autocomplete="username" required autofocus>
                <small style="color:var(--muted); font-size:12px;">We'll never share your username with anyone else.</small>
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="_password"
                       placeholder="Password" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-login">Login</button>
        </form>

        <p style="text-align:center; margin-top:15px; color:var(--muted);">
            No account? <a href="{{ path('app_register') }}" style="color:var(--primary);">Register here</a>
        </p>
    </div>
</body>
</html>
