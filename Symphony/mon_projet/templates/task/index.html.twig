{% extends 'base.html.twig' %}
{% block title %}TaskFlow{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/tasklist.css') }}">
{% endblock %}
{% block body %}

<div class="tasks-container">

    {# MAIN - liste #}
    <div class="main">

        {% for message in app.flashes('success') %}
            <div class="flash">✓ {{ message }}</div>
        {% endfor %}

        <div class="main-header">
            <div class="main-title">All Tasks</div>
            <span style="color:#444; font-size:12px; letter-spacing:1px;">LIST</span>
        </div>
<div class="stats-boxes">

    <div class="stat-box">
        <h2>{{ activeCount }}</h2>
        <p>Active Tasks</p>
    </div>

    <div class="stat-box">
        <h2>{{ urgentCount }}</h2>
        <p>Urgent Tasks</p>
    </div>

</div>
{% if is_granted('ROLE_ADMIN') %}
<div class="filter-select">

<form method="GET">

    <select name="group" onchange="this.form.submit()">

        <option value="">All Groups</option>

        {% for group in groups %}

            <option
                value="{{ group.id }}"
                {% if selectedGroup == group.id %}
                    selected
                {% endif %}
            >
                {{ group.name }}
            </option>

        {% endfor %}

    </select>

</form>

</div>
{% endif %}
        {% if tasks is empty %}

    <div class="empty">
        No tasks found
    </div>

{% else %}

<table class="tasks-table">

    <thead>
        <tr>
            <th>Task</th>
            <th>Description</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Deadline</th>
            <th>Actions</th>        
            </tr>
    </thead>

    <tbody>

    {% for task in tasks|reverse %}

        <tr class="{% if task.status == 'done' %}completed-task{% endif %}">

            <td>{{ task.title }}</td>

            <td>
                {% for tag in task.tags %}
                    {{ tag }}
                    {% if not loop.last %}, {% endif %}
                {% endfor %}
            </td>

            <td>

                <span class="priority {{ task.priority }}">
                    {{ task.priority }}
                </span>

            </td>

 <td>

    {% if task.status == 'done' %}

        <span class="status status-done">
            Done
        </span>

    {% else %}

        <span class="status status-progress">
            In Progress
        </span>

    {% endif %}

</td>

            <td>

                {% if task.dueDate %}
                    {{ task.dueDate }}
                {% endif %}

            </td>

<td class="actions-col">

    <div class="actions">

        {# USER #}
            {% if app.user and 'ROLE_USER' in app.user.roles and 'ROLE_ADMIN' not in app.user.roles %}
    {% if task.status != 'done' %}

        <a
            href="{{ path('task_complete', {id: task.id}) }}"
            class="btn-complete"
        >
            ✓
        </a>

    {% endif %}

{% endif %}
       

        {% if app.user and 'ROLE_ADMIN' in app.user.roles %}

    {% if task.status == 'done' %}

        <a
            href="{{ path('task_restore', {id: task.id}) }}"
            class="btn-restore"
        >
            ↺
        </a>

    {% endif %}

    <a
        href="{{ path('task_delete', {id: task.id}) }}"
        class="btn-delete"
        onclick="return confirm('Delete task ?')"
    >
        ✕
    </a>

{% endif %}

    </div>

</td>
    {% endfor %}

    </tbody>

</table>

{% endif %}
    </div>

</div>
{% endblock %}