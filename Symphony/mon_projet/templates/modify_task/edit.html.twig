{% extends 'base.html.twig' %}

{% block title %}Edit Task — TaskFlow{% endblock %}

{% block body %}
<div class="layout">

    {# ------- SIDEBAR : FORMULAIRE DE MODIFICATION -------- #}
    <div class="sidebar">

        <div class="sidebar-title">
            ✎ Edit Task
            <span style="font-size:11px; color:#666;">#{{ task.id }}</span>
        </div>

        {# Badge admin / user (juste informatif) #}
        <p style="margin: 8px 0 16px; font-size: 11px; color: #c8ff00; letter-spacing: 1px;">
            {% if is_granted('ROLE_ADMIN') %}
                ADMIN — tous les champs modifiables
            {% else %}
                USER — uniquement le statut modifiable
            {% endif %}
        </p>

        {# Messages flash (erreurs) #}
        {% for message in app.flashes('error') %}
            <div class="flash" style="background:#1f0000; border-color:#ff444433; color:#ff4444;">
                ✕ {{ message }}
            </div>
        {% endfor %}

        {# ----- FORMULAIRE ------ #}
        <form method="POST" action="" class="modify-form">

            {# TITLE — admin seulement #}
            <div class="field">
                <label>Title</label>
                <input
                    class="input"
                    type="text"
                    name="title"
                    value="{{ task.title }}"
                    maxlength="200"
                    required
                    {% if not is_granted('ROLE_ADMIN') %}readonly{% endif %}>
            </div>

            {# TAGS — admin seulement #}
            <div class="field">
                <label>Tags (séparés par virgules)</label>
                <input
                    class="input"
                    type="text"
                    name="tags"
                    value="{{ task.tags|join(', ') }}"
                    placeholder="symfony, php, urgent"
                    {% if not is_granted('ROLE_ADMIN') %}readonly{% endif %}>
            </div>

            {# PRIORITY — admin seulement #}
            <div class="field">
                <label>Priority</label>
                <select
                    class="input"
                    name="priority"
                    {% if not is_granted('ROLE_ADMIN') %}disabled{% endif %}>
                    <option value="low"    {% if task.priority == 'low'    %}selected{% endif %}>Low</option>
                    <option value="medium" {% if task.priority == 'medium' %}selected{% endif %}>Medium</option>
                    <option value="high"   {% if task.priority == 'high'   %}selected{% endif %}>High</option>
                </select>
            </div>

            {# MOVEMENT — admin seulement #}
            <div class="field">
                <label>Movement (Rythme)</label>
                <select
                    class="input"
                    name="movement"
                    {% if not is_granted('ROLE_ADMIN') %}disabled{% endif %}>
                    <option value="allegro" {% if task.movement == 'allegro' %}selected{% endif %}>Allegro</option>
                    <option value="andante" {% if task.movement == 'andante' %}selected{% endif %}>Andante</option>
                    <option value="adagio"  {% if task.movement == 'adagio'  %}selected{% endif %}>Adagio</option>
                    <option value="presto"  {% if task.movement == 'presto'  %}selected{% endif %}>Presto</option>
                </select>
            </div>

            {# DUE DATE — admin seulement #}
            <div class="field">
                <label>Due Date</label>
                <input
                    class="input"
                    type="date"
                    name="due_date"
                    value="{{ task.dueDate }}"
                    {% if not is_granted('ROLE_ADMIN') %}readonly{% endif %}>
            </div>

            {# STATUS — modifiable par TOUS #}
            <div class="field">
                <label>Status</label>
                <select class="input" name="status">
                    <option value="todo"        {% if task.status == 'todo'        %}selected{% endif %}>To Do</option>
                    <option value="in progress" {% if task.status == 'in progress' %}selected{% endif %}>In Progress</option>
                    <option value="done"        {% if task.status == 'done'        %}selected{% endif %}>Done</option>
                </select>
            </div>

            {#
                Si l'utilisateur est Regular, les selects disabled ne sont PAS
                envoyés par le navigateur. On les renvoie via des hidden inputs
                pour que le serveur conserve les valeurs actuelles.
                (Le contrôleur les ignore de toute façon, mais ça évite des
                valeurs manquantes dans le POST.)
            #}
            {% if not is_granted('ROLE_ADMIN') %}
                <input type="hidden" name="priority" value="{{ task.priority }}">
                <input type="hidden" name="movement" value="{{ task.movement }}">
            {% endif %}

            <button type="submit" class="btn-submit">
                Save Changes
            </button>

        </form>

        <a href="{{ path('task_list') }}"
           style="display:block; text-align:center; margin-top:14px; color:#444; font-size:12px; text-decoration:none;">
            ← Retour à la liste
        </a>

    </div>


    {# ------- MAIN : APERÇU ------- #}
    <div class="main">

        {% for message in app.flashes('success') %}
            <div class="flash">✓ {{ message }}</div>
        {% endfor %}

        <div class="main-header">
            <div class="main-title">Preview</div>
            <span style="color:#444; font-size:12px; letter-spacing:1px;">CURRENT VALUES</span>
        </div>

        <ul class="task-list">
            <li class="task-item {{ task.priority }}">
                <div>
                    <div class="task-name">{{ task.title }}</div>
                    <div class="task-meta">
                        <span class="pill pill-green">{{ task.priority|upper }}</span>
                        <span class="pill">{{ task.movement }}</span>
                        <span class="pill">{{ task.status }}</span>
                        {% for tag in task.tags %}
                            <span class="tag">{{ tag }}</span>
                        {% endfor %}
                        {% if task.dueDate %}
                            <span class="pill">📅 {{ task.dueDate }}</span>
                        {% endif %}
                    </div>
                </div>
            </li>
        </ul>

        <p style="margin-top: 30px; color:#444; font-size:12px; text-align:center;">
            Modifie les champs à gauche et clique sur "Save Changes".
        </p>

    </div>

</div>
{% endblock %}
