<link rel="stylesheet" href="{{ asset('css/style.css') }}">
<nav>
    <label class="logo">Todo_Web_App</label>
    <ul>
        <li><a href="{{ path('app_welcome') }}">Home</a></li>
        <li><a href="{{ path('task_add') }}">Add Task</a></li>
        <li><a href="{{ path('task_list') }}">Tasks List</a></li>
        <li><a href="{{ path('app_statistics') }}">Stats</a></li>
        <li><a href="{{ path('app_logout') }}">Logout</a></li>
        <li class="nav-avatar">
        
            <a href="{{ path('app_user_profile', {id: app.user.id}) }}">
                {% if app.user.profileImage and app.user.profileImage != 'default_avatar.png' %}
                    <img src="{{ asset('uploads/' ~ app.user.profileImage) }}"
                         width="34" height="34"
                         style="border-radius:50%; object-fit:cover; border:2px solid var(--primary); vertical-align:middle;"
                         title="{{ app.user.username }}">
                {% else %}
                    <img src="{{ asset('uploads/default_avatar.png') }}"
                         width="34" height="34"
                         style="border-radius:50%; object-fit:cover; border:2px solid var(--primary); vertical-align:middle;"
                         title="{{ app.user.username }}">
                {% endif %}
            </a>
        </li>
    </ul>
</nav>
